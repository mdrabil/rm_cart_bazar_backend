PAYTM_LIVE_MERCHANT_KEY=

# ── Shipping providers (ENV names stored in MongoDB; values here only) ──
SHIPPING_WEBHOOK_BASE_URL=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_LIVE_EMAIL=
SHIPROCKET_LIVE_PASSWORD=
